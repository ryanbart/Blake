# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# `npm run db:up` starts a local Postgres 16 on port 5433 and prints this URL.
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/blake?schema=public"

# ---------------------------------------------------------------------------
# Transports — "mock" reads fixtures/, "live" hits the real API.
# Everything works end to end with all three set to "mock" and no credentials.
# ---------------------------------------------------------------------------
DIALPAD_TRANSPORT="mock"
FELLOW_TRANSPORT="mock"
SALESFORCE_TRANSPORT="mock"

# ---------------------------------------------------------------------------
# Dialpad (Phase 1)
# ---------------------------------------------------------------------------
DIALPAD_API_KEY=""
DIALPAD_BASE_URL="https://dialpad.com/api/v2"
# Returned when you register a webhook; used to verify inbound JWT signatures.
DIALPAD_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Fellow (Phase 2)
# ---------------------------------------------------------------------------
FELLOW_API_KEY=""
FELLOW_BASE_URL="https://api.fellow.app/v1"
FELLOW_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Claude analysis
# Without a key the app falls back to a deterministic heuristic analyzer, so the
# seeded dashboard still fills in. Those results are badged "heuristic" in the UI.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
ANALYSIS_MODEL="claude-opus-5"
# Skip analysis for very short calls (voicemails, misdials).
MIN_CALL_SECONDS="45"

# ---------------------------------------------------------------------------
# Salesforce (Phase 3) — per-user OAuth against an External Client App
# ---------------------------------------------------------------------------
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
SALESFORCE_LOGIN_URL="https://test.salesforce.com"
SALESFORCE_REDIRECT_URI="http://localhost:3000/api/crm/oauth/callback"
SALESFORCE_API_VERSION="v64.0"

# ---------------------------------------------------------------------------
# Secrets
# 32-byte key, base64. Encrypts stored OAuth refresh tokens at rest.
# Generate: openssl rand -base64 32
# ---------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Safety
# Global kill switch for autonomous action execution. Leave "true" until you
# have watched the system behave. Queued actions stay queued while it is on.
# ---------------------------------------------------------------------------
AUTOMATION_KILL_SWITCH="true"
